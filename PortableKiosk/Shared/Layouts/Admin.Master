<%@ Master
    Language="C#"
    MasterPageFile="~/Site.Master"
    AutoEventWireup="true"
    CodeBehind="Admin.Master.cs"
    Inherits="PortableKiosk.Shared.Layouts.AdminLayout" %>

<asp:Content
    ID="AdminBody"
    ContentPlaceHolderID="MainContent"
    runat="server">

    <style>
        html, body {
            margin: 0 !important;
            padding: 0 !important;
            height: 100% !important;
        }
        .body-content {
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
            min-height: 100vh !important;
        }
        .admin-shell {
            display: grid !important;
            grid-template-columns: 260px minmax(0, 1fr) !important;
            min-height: 100vh !important;
            width: 100% !important;
            margin: 0 !important;
            max-width: 100% !important;
            gap: 0 !important;
            border-radius: 0 !important;
            background: #f3f5f8 !important;
        }
        .admin-sidebar {
            align-self: stretch !important;
            background: #17233a !important;
            border-radius: 0 !important;
            color: #f8faff !important;
            display: flex !important;
            flex-direction: column !important;
            min-height: 100vh !important;
            height: 100% !important;
            padding: 1.5rem 1.25rem !important;
            position: sticky !important;
            top: 0 !important;
            max-height: 100vh !important;
            overflow-y: auto !important;
            z-index: 100 !important;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05) !important;
        }
        .admin-sidebar * {
            border-radius: 0 !important;
        }
        .admin-nav a {
            border-radius: 0 !important;
        }
        .admin-content {
            min-width: 0 !important;
            width: 100% !important;
            padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem) 2.5rem !important;
            background: #f3f5f8 !important;
        }
        .admin-content .card,
        .admin-content .card-header,
        .admin-content .card-footer,
        .admin-content .btn,
        .admin-content .form-control,
        .admin-content .form-select,
        .admin-content .nav-link,
        .admin-content .input-group-text,
        .admin-content .alert,
        .admin-content .table {
            border-radius: 0 !important;
        }
        @media screen and (max-width: 767px) {
            .admin-shell {
                grid-template-columns: 1fr !important;
            }
            .admin-sidebar {
                min-height: auto !important;
                height: auto !important;
                max-height: none !important;
                position: static !important;
            }
            .admin-nav {
                grid-template-columns: 1fr 1fr !important;
            }
        }
    </style>

    <div class="admin-shell">
        <aside class="admin-sidebar" aria-label="Admin navigation">
            <div class="admin-sidebar-heading">
                <span>Management</span>
                <strong>Admin workspace</strong>
            </div>

            <nav class="admin-nav">
                <a ID="lnkCatalogConfig" runat="server"
                    href="~/UI/Admin/CatalogConfig.aspx">
                    Catalog setup
                </a>

                <a ID="lnkProducts" runat="server"
                    href="~/UI/Admin/Products.aspx">
                    Products
                </a>

                <a ID="lnkBundles" runat="server"
                    href="~/UI/Admin/Bundles.aspx">
                    Bundles
                </a>

                <a ID="lnkStaff" runat="server"
                    href="~/UI/Admin/StaffAccounts.aspx">
                    Staff accounts
                </a>
            </nav>

            <div class="admin-sidebar-account">
                <span>Signed in as</span>
                <strong><asp:Literal ID="litAdminName" runat="server" /></strong>
                <a runat="server" href="~/UI/Account/SignOut.aspx">
                    Sign out
                </a>
            </div>
        </aside>

        <section class="admin-content">
            <asp:ContentPlaceHolder ID="AdminContent" runat="server" />
        </section>
    </div>

</asp:Content>
