<%@ Master
    Language="C#"
    MasterPageFile="~/Site.Master"
    AutoEventWireup="true"
    CodeBehind="User.Master.cs"
    Inherits="PortableKiosk.Shared.Layouts.UserLayout" %>

<asp:Content
    ID="UserHead"
    ContentPlaceHolderID="HeadContent"
    runat="server">
    <link href="<%= ResolveUrl("~/Content/css/user-kiosk.css") %>" rel="stylesheet" />
</asp:Content>

<asp:Content
    ID="UserBody"
    ContentPlaceHolderID="MainContent"
    runat="server">
    <div class="user-kiosk-shell">
        <header class="user-kiosk-header">
            <a ID="lnkMenu" runat="server"
                class="user-kiosk-brand"
                href="~/UI/User/Menu.aspx"
                aria-label="Portable Kiosk menu">
                <span class="user-kiosk-mark" aria-hidden="true">P</span>
                <span>
                    <strong>Portable Kiosk</strong>
                    <small><asp:Literal ID="litOrderType" runat="server" /></small>
                </span>
            </a>

            <div class="user-kiosk-actions">
                <a class="user-kiosk-cart-info" href="<%= ResolveUrl("~/UI/User/Cart.aspx") %>" aria-label="View shopping cart">
                    <span class="user-kiosk-cart-icon-wrapper" aria-hidden="true">
                        <span class="user-kiosk-cart-icon-pill">
                            <svg class="kiosk-bag-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                            </svg>
                        </span>
                        <asp:Literal ID="litCartCount" runat="server" />
                    </span>
                    <span class="user-kiosk-cart-text">
                        <strong class="user-kiosk-cart-total"><asp:Literal ID="litCartTotal" runat="server" /></strong>
                    </span>
                </a>

                <div class="user-kiosk-action-buttons">
                    <asp:Button
                        ID="btnCancelOrder"
                        runat="server"
                        Text="Cancel order"
                        CssClass="user-cancel-button"
                        CausesValidation="false"
                        data-confirm-cancel="true"
                        OnClick="btnCancelOrder_Click" />

                    <a ID="lnkCart" runat="server"
                        class="user-checkout-button"
                        href="~/UI/User/Cart.aspx">
                        <span>Checkout</span>
                        <svg class="user-checkout-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                </div>
            </div>
        </header>

        <asp:ContentPlaceHolder ID="UserContent" runat="server" />
    </div>
</asp:Content>

<asp:Content
    ID="UserScripts"
    ContentPlaceHolderID="ScriptsContent"
    runat="server">
    <script src="<%= ResolveUrl("~/Scripts/app/user/kiosk.js") %>"></script>
    <asp:ContentPlaceHolder ID="UserScriptsContent" runat="server" />
</asp:Content>
