<%@ Master
    Language="C#"
    MasterPageFile="~/Site.Master"
    AutoEventWireup="true"
    CodeBehind="User.Master.cs"
    Inherits="PortableKiosk.Shared.Layouts.UserLayout" %>

<asp:Content
    ID="UserHead"
    ContentPlaceHolderID="HeadContent"
    runat="server">
</asp:Content>

<asp:Content
    ID="UserBody"
    ContentPlaceHolderID="MainContent"
    runat="server">
    <div id="userKioskShell" runat="server" class="user-kiosk-shell group/menu @container/menu relative mx-auto min-h-screen min-h-dvh w-full max-w-[860px] kiosk-portrait:has-[.menu-layout]:!max-w-none overflow-x-hidden bg-slate-50 text-slate-900 shadow-[0_0_40px_rgba(15,23,42,0.12)]">
        <header id="userKioskHeader" runat="server" class="user-kiosk-header flex min-h-[84px] items-center justify-between gap-6 bg-slate-900 px-[clamp(1rem,3vw,2rem)] py-4 text-white">
            <a ID="lnkMenu" runat="server"
                class="user-kiosk-brand inline-flex items-center gap-3 text-white no-underline transition-opacity hover:opacity-95"
                href="~/UI/User/Menu.aspx"
                aria-label="Portable Kiosk menu">
                <img src="<%= ResolveUrl("~/Content/images/portable-kiosk-logo.png") %>" alt="" width="48" height="48" class="user-kiosk-mark size-12 shrink-0 object-contain" />
                <span class="grid gap-0.5">
                    <strong class="text-[1.1rem] font-bold tracking-tight">Portable Kiosk</strong>
                    <small class="text-[0.82rem] font-medium text-slate-400"><asp:Literal ID="litOrderType" runat="server" /></small>
                </span>
            </a>

            <div id="userKioskActions" runat="server" class="user-kiosk-actions flex items-center justify-between gap-[clamp(0.35rem,2cqw,1.25rem)]">
                <a class="user-kiosk-cart-info inline-flex items-center gap-[clamp(0.35rem,2.2cqw,1.25rem)] rounded-[clamp(0.5rem,0.75cqw,1.25rem)] px-1 py-1 text-slate-900 no-underline transition-opacity hover:opacity-95 group-has-[.menu-layout]/menu:gap-[clamp(0.35rem,2.5cqw,1.75rem)]" href="<%= ResolveUrl("~/UI/User/Cart.aspx") %>" aria-label="View shopping cart">
                    <span class="user-kiosk-cart-icon-wrapper relative inline-flex shrink-0 items-center justify-center" aria-hidden="true">
                        <span class="user-kiosk-cart-icon-pill flex h-[clamp(2rem,5cqw,4.75rem)] w-[clamp(2rem,5cqw,4.75rem)] shrink-0 items-center justify-center rounded-[clamp(0.5rem,0.75cqw,1.25rem)] border border-amber-200 bg-amber-50 text-amber-700 [&_svg]:h-[clamp(1rem,2.5cqw,2.5rem)] [&_svg]:w-[clamp(1rem,2.5cqw,2.5rem)] group-has-[.menu-layout]/menu:h-[clamp(2rem,7cqw,12rem)] group-has-[.menu-layout]/menu:w-[clamp(2rem,7cqw,12rem)] max-[480px]:h-8 max-[480px]:w-8 group-has-[.menu-layout]/menu:rounded-[clamp(0.5rem,3cqw,5rem)] max-[480px]:rounded-lg group-has-[.menu-layout]/menu:[&_svg]:h-[clamp(1rem,3.5cqw,6rem)] group-has-[.menu-layout]/menu:[&_svg]:w-[clamp(1rem,3.5cqw,6rem)] max-[480px]:[&_svg]:h-4 max-[480px]:[&_svg]:w-4">
                            <svg class="kiosk-bag-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                            </svg>
                        </span>
                        <asp:Literal ID="litCartCount" runat="server" />
                    </span>
                    <span class="user-kiosk-cart-text inline-flex items-center">
                        <strong class="user-kiosk-cart-total whitespace-nowrap text-[clamp(0.95rem,2.4cqw,3.5rem)] font-black leading-none tracking-tight text-slate-900 group-has-[.menu-layout]/menu:text-[clamp(0.95rem,3.5cqw,6rem)] max-[480px]:text-sm"><asp:Literal ID="litCartTotal" runat="server" /></strong>
                    </span>
                </a>

                <div class="user-kiosk-action-buttons flex items-center gap-[clamp(0.25rem,1.5cqw,1.5rem)] group-has-[.menu-layout]/menu:gap-[clamp(0.25rem,1.75cqw,1.75rem)]">
                    <asp:Button
                        ID="btnCancelOrder"
                        runat="server"
                        Text="Cancel order"
                        CssClass="user-cancel-button kiosk-cta-button kiosk-cta-button-secondary kiosk-cta-button-danger"
                        CausesValidation="false"
                        data-confirm-cancel="true"
                        OnClick="btnCancelOrder_Click" />

                    <a ID="lnkCart" runat="server"
                        class="user-checkout-button group/cart kiosk-cta-button kiosk-cta-button-primary"
                        aria-label="Checkout"
                        href="~/UI/User/Cart.aspx">
                        <span>Checkout</span>
                        <svg class="user-checkout-arrow h-[clamp(0.75rem,2.2cqw,3rem)] w-[clamp(0.75rem,2.2cqw,3rem)] max-[480px]:h-3.5 max-[480px]:w-3.5 transition-transform group-hover/cart:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                </div>
            </div>
        </header>

        <asp:ContentPlaceHolder ID="UserContent" runat="server" />
    </div>
</asp:Content>

<asp:Content
    ID="UserScripts"
    ContentPlaceHolderID="ScriptsContent"
    runat="server">
    <script src="<%= ResolveUrl("~/Scripts/app/user/kiosk.js") %>?v=3"></script>
    <asp:ContentPlaceHolder ID="UserScriptsContent" runat="server" />
</asp:Content>
